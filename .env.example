# Create a Replicate account and generate an API token in its account settings.
REPLICATE_API_TOKEN=

# Optional owner-only password login. Public users can sign in with Google/GitHub.
APP_USERNAME=
APP_PASSWORD=

# Generate a private session signing secret:
# node -p "require('node:crypto').randomBytes(32).toString('base64url')"
APP_SESSION_SECRET=

# Set the exact public origin used by OAuth (no path or trailing slash).
APP_BASE_URL=https://your-app.example.com

# Create OAuth apps and register:
# https://your-app.example.com/api/auth/callback/google
# https://your-app.example.com/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

PORT=3000
MAX_GENERATIONS_PER_HOUR=5

# Optional: local folder for temporary merged MP4 files (removed after 30 minutes).
VIDEO_OUTPUT_DIRECTORY=

# Optional: override the ffmpeg-static binary path.
FFMPEG_PATH=
